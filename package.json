{
  "name": "nookframe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/main.js",
    "dev": "tsx server/main.ts",
    "test": "node scripts/run-tests.mjs test/*.test.ts",
    "test:rpc": "node scripts/run-tests.mjs test/rpc.smoke.ts",
    "test:browser": "node scripts/run-tests.mjs test/browser.smoke.ts test/threads.browser.smoke.ts test/auth.browser.smoke.ts test/composer.browser.smoke.ts test/photos.browser.smoke.ts test/artifacts.browser.smoke.ts test/jobs.browser.smoke.ts test/agent-presence.browser.smoke.ts test/attention.browser.smoke.ts test/takeovers.browser.smoke.ts test/mobile-reading.browser.smoke.ts",
    "test:container": "node scripts/run-tests.mjs --container test/container.smoke.ts",
    "ops": "tsx server/operations-cli.ts",
    "image": "tsx server/image-cli.ts",
    "mail": "tsx mail/cli.ts",
    "calendar": "tsx calendar/cli.ts",
    "google": "tsx google/cli.ts",
    "jobs": "tsx server/jobs/cli.ts jobs",
    "test:mail-container": "node scripts/run-tests.mjs --container test/mail.container.smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "heic-decode": "2.1.0",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
