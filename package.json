{
  "name": "pi-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/main.js",
    "dev": "tsx server/main.ts",
    "test": "tsx --test test/*.test.ts",
    "test:rpc": "tsx --test test/rpc.smoke.ts",
    "test:browser": "tsx --test test/browser.smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "proper-lockfile": "4.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
